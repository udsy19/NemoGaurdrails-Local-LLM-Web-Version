# LLMinate Dashboard Configuration

# WebSocket Configuration
REACT_APP_WEBSOCKET_URL=ws://scanllmai.com/ws/guardrails/

# Mock Data Control
# Set to 'false' to disable mock data fallback (production mode)
# Set to 'true' to enable mock data fallback (demo/development mode)
REACT_APP_ENABLE_MOCK_DATA=false

# Dashboard Settings
REACT_APP_UPDATE_FREQUENCY=15000
REACT_APP_FALLBACK_TIMEOUT=3000